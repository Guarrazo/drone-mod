  protected func DefineTexts() {
    this.Text("Mod-DroneCompanion-Shard-Bombus", "Pincho de control: dron Abejorro");
    this.Text("Mod-DroneCompanion-Shard-Bombus-Desc", "Autorización de control del mercado gris. Habilita el despliegue en campo de drones de apoyo Abejorro mediante una interfaz de dron acompañante.");
    this.Text("Mod-DroneCompanion-Shard-Octant", "Pincho de control: dron Octant");
    this.Text("Mod-DroneCompanion-Shard-Octant-Desc", "Autorización de control del mercado gris. Habilita el despliegue en campo de drones de combate Octant mediante una interfaz de dron acompañante.");
    this.Text("Mod-DroneCompanion-Shard-Griffin", "Pincho de control: dron Grifo");
    this.Text("Mod-DroneCompanion-Shard-Griffin-Desc", "Autorización de control del mercado gris. Habilita el despliegue en campo de drones de combate Grifo mediante una interfaz de dron acompañante.");
    this.Text("Mod-DroneCompanion-Shard-Wyvern", "Pincho de control: dron Wyverno");
    this.Text("Mod-DroneCompanion-Shard-Wyvern-Desc", "Autorización de control del mercado gris. Habilita el despliegue en campo de drones de combate Wyverno mediante una interfaz de dron acompañante.");
    this.Text("Mod-DroneCompanion-Shard-Minotaur", "Pincho de control: meca Minotauro");
