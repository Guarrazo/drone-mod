    this.Text("Mod-DroneCompanion-Shard-Android", "Pincho de control: Android");
    this.Text("Mod-DroneCompanion-Shard-Android-Desc", "Autorización de control del mercado gris. Habilita el despliegue en campo de unidades Android de combate mediante una interfaz de dron acompañante.");
    this.Text("Mod-DroneCompanion-Shard-Cerberus", "Pincho de control: Cerberus");
