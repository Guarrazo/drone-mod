    this.Text("Mod-DroneCompanion-Shard-Flathead", "Pincho de control: Cabezaplana");
    this.Text("Mod-DroneCompanion-Shard-Flathead-Desc", "Autorización de control del mercado gris. Despliega una unidad Cabezaplana fija para exhibición: no te sigue ni pelea.");
    this.Text("Mod-DroneCompanion-Shard-Chimera", "Pincho de control: Quimera");
