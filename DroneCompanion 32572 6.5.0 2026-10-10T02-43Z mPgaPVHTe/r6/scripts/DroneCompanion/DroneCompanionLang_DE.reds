  protected func DefineTexts() {
    this.Text("Mod-DroneCompanion-Shard-Bombus", "Bombus-Drohnen-Kontrollsplitter");
    this.Text("Mod-DroneCompanion-Shard-Bombus-Desc", "Kontrollfreigabe vom Graumarkt. Erlaubt den Feldeinsatz von Bombus-Supportdrohnen über ein Drohnen-Companion-Interface.");
    this.Text("Mod-DroneCompanion-Shard-Octant", "Octant-Drohnen-Kontrollsplitter");
    this.Text("Mod-DroneCompanion-Shard-Octant-Desc", "Kontrollfreigabe vom Graumarkt. Erlaubt den Feldeinsatz von Octant-Kampfdrohnen über ein Drohnen-Companion-Interface.");
    this.Text("Mod-DroneCompanion-Shard-Griffin", "Griffin-Drohnen-Kontrollsplitter");
    this.Text("Mod-DroneCompanion-Shard-Griffin-Desc", "Kontrollfreigabe vom Graumarkt. Erlaubt den Feldeinsatz von Griffin-Kampfdrohnen über ein Drohnen-Companion-Interface.");
    this.Text("Mod-DroneCompanion-Shard-Wyvern", "Wyvern-Drohnen-Kontrollsplitter");
    this.Text("Mod-DroneCompanion-Shard-Wyvern-Desc", "Kontrollfreigabe vom Graumarkt. Erlaubt den Feldeinsatz von Wyvern-Kampfdrohnen über ein Drohnen-Companion-Interface.");
    this.Text("Mod-DroneCompanion-Shard-Minotaur", "Minotaur-Mech-Kontrollsplitter");
