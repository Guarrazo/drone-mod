    this.Text("Mod-DroneCompanion-Shard-Android", "Android-Kontrollsplitter");
    this.Text("Mod-DroneCompanion-Shard-Android-Desc", "Kontrollfreigabe vom Graumarkt. Erlaubt den Feldeinsatz von Kampfandroiden über ein Drohnen-Companion-Interface.");
    this.Text("Mod-DroneCompanion-Shard-Cerberus", "Cerberus-Kontrollsplitter");
    this.Text("Mod-DroneCompanion-Shard-Cerberus-Desc", "Kontrollfreigabe vom Graumarkt, Preis entsprechend. Setzt einen Cerberus als Eskorte ein: Er folgt dir und steckt Treffer ein, aber seine Kampfroutinen bleiben auf seinen eigenen Auftrag festgelegt.");
    this.Text("Mod-DroneCompanion-Shard-Flathead", "Flathead-Kontrollsplitter");
    this.Text("Mod-DroneCompanion-Shard-Flathead-Desc", "Kontrollfreigabe vom Graumarkt. Stellt eine stationäre Flathead-Einheit zur Schau auf: Sie folgt nicht und kämpft nicht.");
    this.Text("Mod-DroneCompanion-Shard-Chimera", "Chimera-Kontrollsplitter");
    this.Text("Mod-DroneCompanion-Shard-Chimera-Desc", "Kontrollfreigabe vom Graumarkt, Sammlerqualität. Stellt eine stationäre Chimera-Einheit zur Schau auf: Sie folgt nicht und kämpft nicht.");
    this.Text("Mod-DroneCompanion-Capacity", "Drohnen-Kapazitätsmodul");
