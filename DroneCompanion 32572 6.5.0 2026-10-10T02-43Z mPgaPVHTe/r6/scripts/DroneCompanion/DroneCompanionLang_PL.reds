public class DroneCompanionLocPL extends ModLocalizationPackage {
  protected func DefineTexts() {
    this.Text("Mod-DroneCompanion-Shard-Bombus", "Drzazga sterowania: dron Bombus");
    this.Text("Mod-DroneCompanion-Shard-Bombus-Desc", "Autoryzacja sterowania z szarej strefy. Pozwala wystawiać w terenie drony wsparcia Bombus przez interfejs drona towarzysza.");
    this.Text("Mod-DroneCompanion-Shard-Octant", "Drzazga sterowania: dron Octant");
    this.Text("Mod-DroneCompanion-Shard-Octant-Desc", "Autoryzacja sterowania z szarej strefy. Pozwala wystawiać w terenie drony bojowe Octant przez interfejs drona towarzysza.");
    this.Text("Mod-DroneCompanion-Shard-Griffin", "Drzazga sterowania: dron Griffin");
    this.Text("Mod-DroneCompanion-Shard-Griffin-Desc", "Autoryzacja sterowania z szarej strefy. Pozwala wystawiać w terenie drony bojowe Griffin przez interfejs drona towarzysza.");
    this.Text("Mod-DroneCompanion-Shard-Wyvern", "Drzazga sterowania: dron Wyvern");
    this.Text("Mod-DroneCompanion-Shard-Wyvern-Desc", "Autoryzacja sterowania z szarej strefy. Pozwala wystawiać w terenie drony bojowe Wyvern przez interfejs drona towarzysza.");
    this.Text("Mod-DroneCompanion-Shard-Minotaur", "Drzazga sterowania: mech Minotaur");
    this.Text("Mod-DroneCompanion-Shard-Minotaur-Desc", "Autoryzacja sterowania z szarej strefy. Pozwala wystawiać w terenie mechy bojowe Minotaur przez interfejs drona towarzysza.");
    this.Text("Mod-DroneCompanion-Shard-Android", "Drzazga sterowania: android");
    this.Text("Mod-DroneCompanion-Shard-Android-Desc", "Autoryzacja sterowania z szarej strefy. Pozwala wystawiać w terenie androidy bojowe przez interfejs drona towarzysza.");
    this.Text("Mod-DroneCompanion-Shard-Cerberus", "Drzazga sterowania: Cerberus");
    this.Text("Mod-DroneCompanion-Shard-Cerberus-Desc", "Autoryzacja sterowania z szarej strefy, z ceną na miarę. Wystawia Cerberusa jako eskortę: podąża za tobą i przyjmuje ciosy, ale jego procedury bojowe pozostają zablokowane na własnej misji.");
    this.Text("Mod-DroneCompanion-Shard-Flathead", "Drzazga sterowania: Flathead");
    this.Text("Mod-DroneCompanion-Shard-Flathead-Desc", "Autoryzacja sterowania z szarej strefy. Wystawia nieruchomą jednostkę Flathead na pokaz: nie podąża i nie walczy.");
    this.Text("Mod-DroneCompanion-Shard-Chimera", "Drzazga sterowania: Chimera");
    this.Text("Mod-DroneCompanion-Shard-Chimera-Desc", "Autoryzacja sterowania z szarej strefy, w wersji kolekcjonerskiej. Wystawia nieruchomą jednostkę Chimera na pokaz: nie podąża i nie walczy.");
    this.Text("Mod-DroneCompanion-Capacity", "Moduł pojemności dronów");
    this.Text("Mod-DroneCompanion-Filter", "Drony");
    this.Text("Mod-DroneCompanion-Summon", "Przywołaj drona");
    this.Text("Mod-DroneCompanion-PerksButton", "ULEPSZENIA DRONÓW");
    this.Text("Mod-DroneCompanion-L-fw_tag", "OPROGRAMOWANIE");
    this.Text("Mod-DroneCompanion-L-hd_points", "PUNKTY DRONÓW");
    this.Text("Mod-DroneCompanion-L-hd_firmware", "OPROGRAMOWANIE");
    this.Text("Mod-DroneCompanion-L-hd_title", "ULEPSZENIA DRONÓW");
    this.Text("Mod-DroneCompanion-Capacity-Desc", "Koprocesor z rynku wtórnego do interfejsu drona towarzysza. Każdy moduł podnosi pulę punktów przywołania o jeden, więc naraz zmieści się w terenie więcej dronów.");
    this.Text("Mod-DroneCompanion-Gatekeeper", "Drone Gatekeeper");
    this.Text("Mod-DroneCompanion-Gatekeeper-Desc", "Chip autoryzacyjny klasy riggerskiej, sprzedawany przez handlarzy bronią. Wepnij go w interfejs drona towarzysza, a odblokuje wystawianie w terenie dronów, które masz. Hacki dronów nadal działają na twoim cyberdecku. Wymagany do przywoływania przy włączonym trybie riggera.");
    this.Text("Mod-DroneCompanion-UpCombat", "Drzazga oprogramowania bojowego");
    this.Text("Mod-DroneCompanion-UpCombat-Desc", "Oprogramowanie z rynku wtórnego do interfejsu drona towarzysza. Każda drzazga daje darmowy poziom w każdym ulepszeniu z Walki (pancerz, obrażenia, przeciążenie). Sumuje się z wydanymi punktami, do zwykłego limitu. Liczą się najwyżej 3 drzazgi.");
    this.Text("Mod-DroneCompanion-UpSupport", "Drzazga oprogramowania wsparcia");
    this.Text("Mod-DroneCompanion-UpSupport-Desc", "Oprogramowanie z rynku wtórnego do interfejsu drona towarzysza. Każda drzazga daje darmowy poziom w każdym ulepszeniu ze Wsparcia (autonaprawa, szybka naprawa, ratunek). Sumuje się z wydanymi punktami, do zwykłego limitu. Liczą się najwyżej 3 drzazgi.");
    this.Text("Mod-DroneCompanion-UpUtility", "Drzazga oprogramowania narzędziowego");
    this.Text("Mod-DroneCompanion-UpUtility-Desc", "Oprogramowanie z rynku wtórnego do interfejsu drona towarzysza. Każda drzazga daje darmowy poziom w każdym ulepszeniu z Narzędzi (zasięg, więź). Sumuje się z wydanymi punktami, do zwykłego limitu. Liczą się najwyżej 3 drzazgi.");
