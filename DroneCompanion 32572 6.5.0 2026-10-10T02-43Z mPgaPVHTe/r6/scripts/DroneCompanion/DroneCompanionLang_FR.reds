    this.Text("Mod-DroneCompanion-L-hd_points", "POINTS DE DRONE");
    this.Text("Mod-DroneCompanion-L-hd_firmware", "MICROLOGICIEL");
    this.Text("Mod-DroneCompanion-L-hd_title", "AMÉLIORATIONS DRONE");
    this.Text("Mod-DroneCompanion-Capacity-Desc", "Coprocesseur tiers pour interface de drone compagnon. Chaque module ajoute un point à la réserve d'invocation : plus de drones en même temps sur le terrain.");
    this.Text("Mod-DroneCompanion-Gatekeeper", "Drone Gatekeeper");
    this.Text("Mod-DroneCompanion-Gatekeeper-Desc", "Puce d'autorisation de qualité rigger, vendue chez les armuriers. Branche-la sur ton interface de drone compagnon pour autoriser le déploiement sur le terrain des drones que tu possèdes. Ta cyberconsole continue de faire tourner les piratages rapides de drone. Obligatoire pour invoquer quand le mode Rigger est activé.");
    this.Text("Mod-DroneCompanion-UpCombat", "Éclat de micrologiciel de combat pour drone");
    this.Text("Mod-DroneCompanion-UpCombat-Desc", "Micrologiciel tiers pour interface de drone compagnon. Chaque éclat donne un rang gratuit dans chaque amélioration Combat (armure, dégâts, surcharge). Se cumule avec les points dépensés, jusqu'au plafond normal. 3 éclats pris en compte au maximum.");
    this.Text("Mod-DroneCompanion-UpSupport", "Éclat de micrologiciel de soutien pour drone");
    this.Text("Mod-DroneCompanion-UpSupport-Desc", "Micrologiciel tiers pour interface de drone compagnon. Chaque éclat donne un rang gratuit dans chaque amélioration Soutien (auto-réparation, réparation express, sauvetage). Se cumule avec les points dépensés, jusqu'au plafond normal. 3 éclats pris en compte au maximum.");
    this.Text("Mod-DroneCompanion-UpUtility", "Éclat de micrologiciel utilitaire pour drone");
    this.Text("Mod-DroneCompanion-UpUtility-Desc", "Micrologiciel tiers pour interface de drone compagnon. Chaque éclat donne un rang gratuit dans chaque amélioration Utilitaire (portée, lien). Se cumule avec les points dépensés, jusqu'au plafond normal. 3 éclats pris en compte au maximum.");
