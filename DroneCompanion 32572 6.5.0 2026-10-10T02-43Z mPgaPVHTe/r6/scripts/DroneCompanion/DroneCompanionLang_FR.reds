module DroneCompanion
import Codeware.Localization.*

public class DroneCompanionLocFR extends ModLocalizationPackage {
  protected func DefineTexts() {
    this.Text("Mod-DroneCompanion-Shard-Bombus", "Éclat de contrôle du drone Bombus");
    this.Text("Mod-DroneCompanion-Shard-Bombus-Desc", "Autorisation de contrôle issue du marché gris. Permet le déploiement sur le terrain de drones de soutien Bombus via une interface de drone compagnon.");
    this.Text("Mod-DroneCompanion-Shard-Octant", "Éclat de contrôle du drone Octant");
    this.Text("Mod-DroneCompanion-Shard-Octant-Desc", "Autorisation de contrôle issue du marché gris. Permet le déploiement sur le terrain de drones de combat Octant via une interface de drone compagnon.");
    this.Text("Mod-DroneCompanion-Shard-Griffin", "Éclat de contrôle du drone Griffin");
    this.Text("Mod-DroneCompanion-Shard-Griffin-Desc", "Autorisation de contrôle issue du marché gris. Permet le déploiement sur le terrain de drones de combat Griffin via une interface de drone compagnon.");
    this.Text("Mod-DroneCompanion-Shard-Wyvern", "Éclat de contrôle du drone Wyvern");
    this.Text("Mod-DroneCompanion-Shard-Wyvern-Desc", "Autorisation de contrôle issue du marché gris. Permet le déploiement sur le terrain de drones de combat Wyvern via une interface de drone compagnon.");
    this.Text("Mod-DroneCompanion-Shard-Minotaur", "Éclat de contrôle du méca Minotaure");
    this.Text("Mod-DroneCompanion-Shard-Minotaur-Desc", "Autorisation de contrôle issue du marché gris. Permet le déploiement sur le terrain de mécas de combat Minotaure via une interface de drone compagnon.");
    this.Text("Mod-DroneCompanion-Shard-Android", "Éclat de contrôle Android");
    this.Text("Mod-DroneCompanion-Shard-Android-Desc", "Autorisation de contrôle issue du marché gris. Permet le déploiement sur le terrain d'androïdes de combat via une interface de drone compagnon.");
    this.Text("Mod-DroneCompanion-Shard-Cerberus", "Éclat de contrôle Cerberus");
    this.Text("Mod-DroneCompanion-Shard-Cerberus-Desc", "Autorisation de contrôle issue du marché gris, au prix qui va avec. Déploie un Cerberus en escorte : il te suit et encaisse les coups, mais ses routines de combat restent verrouillées sur sa propre mission.");
    this.Text("Mod-DroneCompanion-Shard-Flathead", "Éclat de contrôle Flathead");
    this.Text("Mod-DroneCompanion-Shard-Flathead-Desc", "Autorisation de contrôle issue du marché gris. Déploie une unité Flathead fixe, pour la vitrine : elle ne te suit pas et ne se bat pas.");
    this.Text("Mod-DroneCompanion-Shard-Chimera", "Éclat de contrôle Chimera");
    this.Text("Mod-DroneCompanion-Shard-Chimera-Desc", "Autorisation de contrôle issue du marché gris, qualité collector. Déploie une unité Chimera fixe, pour la vitrine : elle ne te suit pas et ne se bat pas.");
    this.Text("Mod-DroneCompanion-Capacity", "Module de capacité de drone");
    this.Text("Mod-DroneCompanion-Filter", "Drones");
    this.Text("Mod-DroneCompanion-Summon", "Invoquer un drone");
    this.Text("Mod-DroneCompanion-PerksButton", "AMÉLIORATIONS DRONE");
