public class DroneCompanionLocProvider extends ModLocalizationProvider {
  public func GetPackage(language: CName) -> ref<ModLocalizationPackage> {
    switch language {
      case n"pt-br": return new DroneCompanionLocPT();
      case n"es-es":
      case n"es-mx": return new DroneCompanionLocES();
      case n"fr-fr": return new DroneCompanionLocFR();
      case n"de-de": return new DroneCompanionLocDE();
      case n"ru-ru": return new DroneCompanionLocRU();
      case n"zh-cn": return new DroneCompanionLocZH();
      case n"pl-pl": return new DroneCompanionLocPL();
      default: return new DroneCompanionLocEN();
    };
  }

  public func GetFallback() -> CName {
    return n"en-us";
  }
}

public func DroneCompanionPackageOf(code: String) -> ref<ModLocalizationPackage> {
  if Equals(code, "pt") { return new DroneCompanionLocPT(); };
  if Equals(code, "es") { return new DroneCompanionLocES(); };
  if Equals(code, "fr") { return new DroneCompanionLocFR(); };
  if Equals(code, "de") { return new DroneCompanionLocDE(); };
  if Equals(code, "ru") { return new DroneCompanionLocRU(); };
  if Equals(code, "zh") { return new DroneCompanionLocZH(); };
  if Equals(code, "pl") { return new DroneCompanionLocPL(); };
  return new DroneCompanionLocEN();
}

@addField(PlayerPuppet)
public let m_dcLangPkg: ref<ModLocalizationPackage>;

@addField(PlayerPuppet)
public let m_dcLangCode: String;

@addMethod(PlayerPuppet)
public func DCGetText(code: String, key: String) -> String {
  if !IsDefined(this.m_dcLangPkg) || !Equals(code, this.m_dcLangCode) {
    this.m_dcLangPkg = DroneCompanionPackageOf(code);
    this.m_dcLangCode = code;
  };
  let entry: ref<LocalizationEntry> = this.m_dcLangPkg.GetEntries(EntryType.Interface).Get(LocalizationEntry.Hash(key)) as LocalizationEntry;
  return IsDefined(entry) ? entry.GetVariant(PlayerGender.Default) : "";
}

@addField(PlayerPuppet)
public let m_dcLangPick: String;

@addMethod(PlayerPuppet)
public func DCSetLang(code: String) -> Void {
  this.m_dcLangPick = code;
}

public func DroneCompanionText(key: String) -> String {
  let player: ref<PlayerPuppet> = GetPlayer(GetGameInstance());
  if IsDefined(player) && StrLen(player.m_dcLangPick) > 0 {
    let text: String = player.DCGetText(player.m_dcLangPick, key);
    if StrLen(text) > 0 {
      return text;
    };
  };
  return GetLocalizedTextByKey(StringToName(key));
}
