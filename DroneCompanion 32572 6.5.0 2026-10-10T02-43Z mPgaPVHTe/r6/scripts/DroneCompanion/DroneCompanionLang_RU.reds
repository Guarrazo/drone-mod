module DroneCompanion
import Codeware.Localization.*

public class DroneCompanionLocRU extends ModLocalizationPackage {
  protected func DefineTexts() {
    this.Text("Mod-DroneCompanion-Shard-Bombus", "Чип управления дроном «Подрывник»");
    this.Text("Mod-DroneCompanion-Shard-Bombus-Desc", "Авторизация управления с серого рынка. Разрешает полевое развёртывание дронов поддержки «Подрывник» через интерфейс дрона-компаньона.");
    this.Text("Mod-DroneCompanion-Shard-Octant", "Чип управления дроном «Октант»");
    this.Text("Mod-DroneCompanion-Shard-Octant-Desc", "Авторизация управления с серого рынка. Разрешает полевое развёртывание боевых дронов «Октант» через интерфейс дрона-компаньона.");
    this.Text("Mod-DroneCompanion-Shard-Griffin", "Чип управления дроном «Грифон»");
    this.Text("Mod-DroneCompanion-Shard-Griffin-Desc", "Авторизация управления с серого рынка. Разрешает полевое развёртывание боевых дронов «Грифон» через интерфейс дрона-компаньона.");
    this.Text("Mod-DroneCompanion-Shard-Wyvern", "Чип управления дроном «Виверна»");
    this.Text("Mod-DroneCompanion-Shard-Wyvern-Desc", "Авторизация управления с серого рынка. Разрешает полевое развёртывание боевых дронов «Виверна» через интерфейс дрона-компаньона.");
    this.Text("Mod-DroneCompanion-Shard-Minotaur", "Чип управления мехом «Минотавр»");
    this.Text("Mod-DroneCompanion-Shard-Minotaur-Desc", "Авторизация управления с серого рынка. Разрешает полевое развёртывание боевых мехов «Минотавр» через интерфейс дрона-компаньона.");
    this.Text("Mod-DroneCompanion-Shard-Android", "Чип управления андроидом");
    this.Text("Mod-DroneCompanion-Shard-Android-Desc", "Авторизация управления с серого рынка. Разрешает полевое развёртывание боевых андроидов через интерфейс дрона-компаньона.");
    this.Text("Mod-DroneCompanion-Shard-Cerberus", "Чип управления «Цербером»");
    this.Text("Mod-DroneCompanion-Shard-Cerberus-Desc", "Авторизация управления с серого рынка, цена под стать. Выпускает «Цербер» в роли эскорта: он идёт следом и держит удар, но его боевые процедуры заперты на собственной задаче.");
    this.Text("Mod-DroneCompanion-Shard-Flathead", "Чип управления «Болтом»");
    this.Text("Mod-DroneCompanion-Shard-Flathead-Desc", "Авторизация управления с серого рынка. Выпускает неподвижный «Болт» для показа: он не следует за тобой и не дерётся.");
    this.Text("Mod-DroneCompanion-Shard-Chimera", "Чип управления «Химерой»");
    this.Text("Mod-DroneCompanion-Shard-Chimera-Desc", "Авторизация управления с серого рынка, коллекционного уровня. Выпускает неподвижную «Химеру» для показа: она не следует за тобой и не дерётся.");
    this.Text("Mod-DroneCompanion-Capacity", "Модуль вместимости дронов");
    this.Text("Mod-DroneCompanion-Filter", "Дроны");
    this.Text("Mod-DroneCompanion-Summon", "Вызвать дрон");
    this.Text("Mod-DroneCompanion-PerksButton", "УЛУЧШЕНИЯ ДРОНОВ");
    this.Text("Mod-DroneCompanion-L-fw_tag", "ПРОШИВКА");
    this.Text("Mod-DroneCompanion-L-hd_points", "ОЧКИ ДРОНОВ");
    this.Text("Mod-DroneCompanion-L-hd_firmware", "ПРОШИВКА");
    this.Text("Mod-DroneCompanion-L-hd_title", "УЛУЧШЕНИЯ ДРОНОВ");
    this.Text("Mod-DroneCompanion-Capacity-Desc", "Сопроцессор с вторичного рынка для интерфейса дрона-компаньона. Каждый модуль поднимает запас очков вызова на единицу, так что в поле можно держать больше дронов.");
    this.Text("Mod-DroneCompanion-Gatekeeper", "Привратник дронов");
    this.Text("Mod-DroneCompanion-Gatekeeper-Desc", "Чип авторизации риггерского класса, продаётся в магазинах оружия. Поставь его в интерфейс дрона-компаньона, чтобы разрешить полевое развёртывание своих дронов. Скрипты для дронов всё так же крутит твоя кибердека. Нужен для вызова дронов при включённом режиме риггера.");
    this.Text("Mod-DroneCompanion-UpCombat", "Чип боевой прошивки дронов");
    this.Text("Mod-DroneCompanion-UpCombat-Desc", "Неоригинальная прошивка для интерфейса дрона-компаньона. Каждый чип даёт по бесплатному рангу во всех боевых улучшениях (броня, урон, перегрузка). Складывается с потраченными очками до обычного потолка. Считаются до 3 чипов.");
    this.Text("Mod-DroneCompanion-UpSupport", "Чип прошивки поддержки дронов");
    this.Text("Mod-DroneCompanion-UpSupport-Desc", "Неоригинальная прошивка для интерфейса дрона-компаньона. Каждый чип даёт по бесплатному рангу во всех улучшениях поддержки (саморемонт, быстрый ремонт, спасение). Складывается с потраченными очками до обычного потолка. Считаются до 3 чипов.");
    this.Text("Mod-DroneCompanion-UpUtility", "Чип служебной прошивки дронов");
    this.Text("Mod-DroneCompanion-UpUtility-Desc", "Неоригинальная прошивка для интерфейса дрона-компаньона. Каждый чип даёт по бесплатному рангу во всех служебных улучшениях (дальность, связь). Складывается с потраченными очками до обычного потолка. Считаются до 3 чипов.");
